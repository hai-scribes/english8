# Atelier runtime state ---
.specs/.orchestra/
.atelier/.orchestra-overrides/
.atelier/local/
.atelier/gate-routing.local.yaml
.atelier/supervision.local.yaml
.atelier/command-version.yaml
.atelier/.refresh-commands.lock
.worktrees/
.specs/prototype/*.cap-lock
reports/*.lock
reports/*.status.json

# /rigor drive scaffolding — sealed contract + checkers, not the deliverable
.rigor/

# Node deps for the reading-screen gate (jsdom) ---
node_modules/

# Atelier /save-progress session snapshots (local-only)
saved-progress/*.md

saved-progress/archive/*.md

# Atelier prototype-lane transients. The lane's PLAN (.specs/prototype/*.json,
# *.yaml, *.md) and its RUN EVIDENCE (reports/*.json, *.html) are worth keeping;
# these are not. Locks are per-process and meaningless once it exits; the
# per-variant event streams are live progress telemetry the dashboard tails.
.specs/prototype/.cap-lock
.specs/.orchestra/
reports/*.lock
reports/.*.lock
