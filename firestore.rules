rules_version = '2';

// A learner's work is hers alone: each account reads and writes only the
// documents under its own uid, and nothing else in the database is reachable
// by anyone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/kv/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
